{
  "info": {
    "name": "retailers - SMEPay",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{retailerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "retailerToken",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "paymentKey",
      "value": "smepay-staging-001"
    }
  ],
  "item": [
    {
      "name": "wallet",
      "item": [
        {
          "name": "smepay",
          "item": [
            {
              "name": "create-topup",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "{{paymentKey}}"
                  }
                ],
                "url": "{{baseUrl}}/api/retailer/wallet/topups",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"100.50\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200,202]));",
                      "const result=pm.response.json();",
                      "pm.test(\"API success\",()=>pm.expect(result.success).to.eql(true));",
                      "if(result.success && result.data) pm.collectionVariables.set(\"paymentId\",result.data.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "resume-checkout",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/retailer/wallet/topups/{{paymentId}}/checkout"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200,202]));",
                      "const result=pm.response.json();",
                      "pm.test(\"API success\",()=>pm.expect(result.success).to.eql(true));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "check-status",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/retailer/wallet/topups/{{paymentId}}/status",
                "body": {
                  "mode": "raw",
                  "raw": "{}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200,202]));",
                      "const result=pm.response.json();",
                      "pm.test(\"API success\",()=>pm.expect(result.success).to.eql(true));"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
