                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "const json = pm.response.json();",
                      "pm.test(\"Response success flag\", function () { pm.expect(json.success).to.eql(true); });",
                      "if (pm.response.code < 400) {",
                      "  pm.environment.set(\"DISTRIBUTOR_TOKEN\", json.data.access_token);",
                      "}",
                      "pm.test(\"No password hash is returned\", function () { pm.expect(json.data.account).not.to.have.property(\"password_hash\"); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{BASE_URL_DISTRIBUTOR}}login",
                "description": "Sequential step 52. Expected HTTP 200. Fixture-only verification.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"phone\": \"{{DISTRIBUTOR_PHONE}}\",\n    \"password\": \"{{DISTRIBUTOR_PASSWORD}}\"\n}",
