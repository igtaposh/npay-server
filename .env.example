
NODE_ENV=production
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=npay
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
SALT_ROUNDS=12
# Required HMAC secret (at least 32 bytes), including while the fixed OTP is in use.
# Temporary OTP is 123456 in config/otp.js; no SMS/email is sent.
OTP_SECRET=

GIFT_CODE_KEY=

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081

# Keep unset/blank to retain the existing manual wallet checkout.
# Set PAYMENT_GATEWAY=smepay only after configuring the fields below.
PAYMENT_GATEWAY=
SMEPAY_ENVIRONMENT=live
SMEPAY_CLIENT_ID=
SMEPAY_CLIENT_SECRET=
SMEPAY_CALLBACK_URL=https://your-api.example.com/api/retailer/payments/smepay/webhook
# REQUIRED: obtain the Inline DQR validation path for your account from SMEPay.
# The adapter sends {client_id, amount, slug} with the external bearer token,
# and requires {status:true, valid:true, payment_status:SUCCESS|TEST_SUCCESS}.
SMEPAY_VALIDATE_PATH=

# MRobotics LAPU automation (leave RECHARGE_PROVIDER blank for existing manual behavior).
RECHARGE_PROVIDER=
MROBOTICS_API_TOKEN=
# Explicit company IDs from YOUR MRobotics dashboard. Choose routes for your own LAPUs.
# Example only: {"jio":5,"airtel":2,"vi":1,"bsnl":4,"tata-play":7,"airtel-dth":24,"dishtv":6,"d2h":11,"sun-direct":12}
MROBOTICS_COMPANY_IDS={}
# Optional: restrict routing to your own LAPU or group.
MROBOTICS_LAPU_ID=
MROBOTICS_GROUP_ID=

# Neon production: use the pooled URL for requests and direct URL for migrations/locks.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
RUN_DB_MIGRATIONS=false
DB_POOL_MAX=10
DB_DIRECT_POOL_MAX=3
DB_CONNECTION_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=300
